{
  "name": "contour-name-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Independent name infrastructure built for Arc Testnet.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "packages:build": "pnpm --filter \"./packages/**\" --if-present build",
    "sdk:build-public": "pnpm --filter @contour/config build && pnpm --filter @contour/normalization build && pnpm --filter @contour/sdk build && node ./scripts/build-public-sdk-package.mjs",
    "sdk:pack": "npm pack ./npm/sdk --dry-run --cache ./.npm-cache",
    "sdk:smoke-public": "node ./scripts/smoke-public-sdk-package.mjs",
    "sdk:smoke-published": "node ./scripts/smoke-public-sdk-package.mjs --registry",
    "predev": "pnpm packages:build",
    "dev": "node ./scripts/dev-web.mjs",
    "build:workspace": "pnpm -r --if-present build",
    "build:contracts": "pnpm build:contracts:compile && pnpm build:contracts:sizes",
    "build:contracts:compile": "forge build --root contracts --skip test",
    "build:contracts:sizes": "forge build --root contracts --sizes --skip script test",
    "prepare:deployment-evidence": "pnpm --filter @contour/config build && node ./scripts/prepare-deployment-evidence.mjs",
    "capture:configured-state": "node ./scripts/capture-configured-chain-state.mjs",
    "capture:v1-economic-cutover": "node ./scripts/capture-v1-economic-cutover.mjs",
    "prepare:v1-cutover-manifest": "pnpm --filter @contour/config build && node ./scripts/prepare-v1-cutover-manifest.mjs",
    "provision:release-secrets": "node ./scripts/provision-release-secrets.mjs",
    "provision:deployer-keystore": "node --env-file=.env --env-file=.env.deployment.local ./scripts/provision-deployer-keystore.mjs",
    "fund:e2e-buyer": "node --env-file=.env --env-file=.local-keystores/release-activation.env ./scripts/fund-e2e-buyer.mjs",
    "sync:vercel-release-env": "node ./scripts/sync-vercel-release-env.mjs",
    "publish:configured-evidence": "pnpm --filter @contour/config build && node ./scripts/publish-configured-evidence.mjs",
    "stage:release": "pnpm --filter @contour/config build && node ./scripts/prepare-release-stage.mjs",
    "prepare:promotion-target-intent": "pnpm --filter @contour/config build && node ./scripts/prepare-promotion-target-intent.mjs",
    "sign:promotion-pass": "pnpm --filter @contour/config build && node --env-file=.env --env-file=.local-keystores/release-activation.env ./scripts/sign-promotion-pass.mjs",
    "admin:activation": "pnpm --filter @contour/config build && node --env-file=.env ./scripts/admin-activation.mjs",
    "smoke:registration": "pnpm --filter @contour/config build && node --env-file=.local-keystores/release-activation.env ./scripts/run-registration-smoke.mjs",
    "acceptance:funded": "pnpm --filter @contour/config build && node --env-file=.env --env-file=.local-keystores/release-activation.env ./scripts/run-funded-acceptance.mjs",
    "drill:operations": "pnpm --filter @contour/config build && node --env-file=.env --env-file=.local-keystores/release-activation.env ./scripts/run-operations-drill.mjs",
    "build": "pnpm build:workspace && pnpm build:contracts",
    "verify:promotion": "pnpm packages:build && node ./scripts/verify-arc-promotion.mjs",
    "verify:promotion:ci": "pnpm packages:build && node ./scripts/verify-arc-promotion-if-required.mjs",
    "preflight:release": "node ./scripts/release-preflight.mjs",
    "preflight:release:strict": "node ./scripts/release-preflight.mjs --strict-promotion",
    "lint": "pnpm -r --if-present lint",
    "pretypecheck": "pnpm packages:build",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm packages:build",
    "test:workspace": "pnpm -r --if-present test",
    "test:scripts": "node --test ./scripts/publish-configured-evidence.test.mjs ./scripts/prepare-release-stage.test.mjs ./scripts/sign-promotion-pass.test.mjs ./scripts/admin-activation.test.mjs ./scripts/run-registration-smoke.test.mjs ./scripts/registration-smoke-evidence.test.mjs ./scripts/run-funded-acceptance.test.mjs ./scripts/run-operations-drill.test.mjs ./scripts/release-preflight.test.mjs ./scripts/arc-rpc-transport.test.mjs ./scripts/operator-key.test.mjs ./scripts/promotion-cli.test.mjs ./scripts/provision-deployer-keystore.test.mjs ./scripts/sync-vercel-release-env.test.mjs ./scripts/v1-economic-cutover-evidence.test.mjs ./scripts/v1-cutover-manifest.test.mjs",
    "test:contracts": "forge test --root contracts --threads 1 -vv",
    "test": "pnpm test:workspace && pnpm test:scripts && pnpm test:contracts",
    "fmt:contracts": "forge fmt --root contracts --check",
    "verify": "pnpm fmt:contracts && pnpm lint && pnpm typecheck && pnpm test && pnpm sdk:build-public && pnpm sdk:pack && pnpm sdk:smoke-public && pnpm build"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "devDependencies": {
    "next": "^16.2.11",
    "viem": "2.55.2"
  }
}

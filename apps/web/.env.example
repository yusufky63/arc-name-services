# Public canonical origin. Production must use the exact manifest hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
REGISTRATION_CHALLENGE_ORIGIN=http://localhost:3002
ARC_RPC_URL=https://rpc.testnet.arc.network

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Production prefers this narrowly named value. Root local development can
# instead load PRIVATE_KEY from the repository-root .env without copying it.
REGISTRATION_PERMIT_SIGNER_PRIVATE_KEY=
REGISTRATION_CHALLENGE_SECRET=
REGISTRATION_PERMIT_TTL_SECONDS=180

# Exact live-release gate. Active non-live manifests remain publicly usable;
# a product-live release supplies the signed binding below.
PRODUCT_LIVE_RELEASE=false

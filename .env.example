# Browser-safe site configuration. Arc network values come only from the
# validated canonical deployment manifest and @contour/config.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Optional. Enables the WalletConnect QR/mobile option in the wallet modal.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# For a live release: <releaseId>:<manifestSha256>:<verifiedAtBlock>
PRODUCT_LIVE_RELEASE=false
# Promotion CLI only. Enable the source flag only for an audited promotion
# ceremony whose source explicitly requires operator authentication.
PROMOTION_CANDIDATE_INGRESS_USERNAME=
PROMOTION_CANDIDATE_INGRESS_PASSWORD=
PROMOTION_AUTHENTICATED_CANDIDATE_SOURCE=false
# The only operational Arc endpoints for this release are the exact .network
# HTTP/WS pair recorded in the canonical manifest. Do not configure a fallback
# RPC host without a separately reviewed release change.
ARC_RPC_URL=https://rpc.testnet.arc.network
# One Arc Testnet EOA is intentionally used for deployment, ownership, treasury
# and EIP-712 permit signing. `pnpm dev`, fund:e2e-buyer, admin:activation,
# acceptance:funded, drill:operations and sign:promotion-pass load this ignored
# root .env. The release commands that need isolated activation material also
# load the ignored .local-keystores/release-activation.env file;
# smoke:registration loads only that isolated file. Local operator
# keys accept either 64 hex characters or the same value with 0x; normalization
# happens only in memory. Never use NEXT_PUBLIC_* for a key.
PRIVATE_KEY=
REGISTRATION_CHALLENGE_SECRET=
# Optional production-specific override. When set, it takes precedence over
# PRIVATE_KEY and must resolve to the same manifest governance account. Store
# the Vercel Sensitive value in canonical 0x-prefixed form.
REGISTRATION_PERMIT_SIGNER_PRIVATE_KEY=
REGISTRATION_PERMIT_TTL_SECONDS=180
REGISTRATION_CHALLENGE_ORIGIN=http://localhost:3002

# Public Arc deployment identity. Every address below is the same account in
# this deliberately simplified testnet release.
DEPLOYER_ADDRESS=
OWNER_ADDRESS=
TREASURY_ADDRESS=
PERMIT_SIGNER_ADDRESS=
RELEASE_ID=
REFERRAL_BPS=
MARKETPLACE_FEE_BPS=
# Promotion verifier trust roots. All lists are operator/CI-owned, not copied
# from the deployment manifest during a release run.
PROMOTION_ALLOWED_FETCH_HOSTS=
PROMOTION_APPROVED_CONTRACT_RUNTIME_HASHES=
PROMOTION_REVIEWER_ADDRESSES=
# Independent, unfunded reviewer key used only by sign:promotion-pass. It must
# not be PRIVATE_KEY and its address must appear in PROMOTION_REVIEWER_ADDRESSES.
PROMOTION_REVIEWER_PRIVATE_KEY=

# Funded Arc Testnet buyer for the marketplace acceptance run. It must differ
# from the governance/seller PRIVATE_KEY because the market rejects self-buy.
E2E_BUYER_PRIVATE_KEY=

# Paid execution is fail-closed by default.
X402_ENABLED=false
